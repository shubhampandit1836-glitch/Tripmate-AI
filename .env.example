# TripMate AI - Environment Variables
# Copy this file to .env and fill in your API keys

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/travel_db

# Groq API Key (required for Qwen/Qwen3 and GPT-OSS models)
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (for real-time web search)
TAVILY_API_KEY=your_tavily_api_key_here

# AviationStack API Key (for flight data)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Default origin IATA code (optional, defaults to DAC - Dhaka)
DEFAULT_ORIGIN_IATA=DAC